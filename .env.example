# Core
ELIO_ENV=production
ELIO_API_PORT=8000
ELIO_OLLAMA_BIND_IP=127.0.0.1
ELIO_OLLAMA_PORT=11434
ELIO_POSTGRES_PORT=5432
ELIO_JWT_SECRET=replace-with-a-random-32-plus-character-secret
ELIO_DATA_KEY=
ELIO_ALLOWED_ORIGINS=https://app.electricsupplysource.co,https://electricsupplysource.co,https://www.electricsupplysource.co,http://localhost:8000
ELIO_DEVICE_ID=DEV-LOCAL
ELIO_RUN_BACKGROUND_WORKER=true
ELIO_PREWARM_TTS=true
ELIO_JOB_POLL_SECONDS=60
ELIO_JOB_BATCH_SIZE=4
SERVER=
ELIO_SERVER_PORT=22
ELIO_SERVER_PATH=~/elio
COMPOSE_PROJECT_NAME=elio
EDGE_NETWORK=platform_edge
ELIO_API_CPUS=2.0
ELIO_API_MEM_LIMIT=4g
ELIO_SUBAGENT_CPUS=1.5
ELIO_SUBAGENT_MEM_LIMIT=2g
ELIO_OLLAMA_CPUS=6.0
ELIO_OLLAMA_MEM_LIMIT=12g
ELIO_POSTGRES_CPUS=1.5
ELIO_POSTGRES_MEM_LIMIT=2g
ELIO_PG_CLIENT_IMAGE=postgres:17
ELIO_BOOTSTRAP_MODELS=qwen3:8b nomic-embed-text qwen2.5vl:7b

# Postgres
ELIO_PG_URI=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Gmail OAuth
ELIO_GMAIL_CLIENT_ID=
ELIO_GMAIL_CLIENT_SECRET=
ELIO_GMAIL_REDIRECT_URI=http://localhost:8080/

# Google Calendar OAuth
ELIO_CAL_CLIENT_ID=
ELIO_CAL_CLIENT_SECRET=
ELIO_CAL_REDIRECT_URI=http://localhost:8080/

# QuickBooks OAuth
ELIO_QBO_CLIENT_ID=
ELIO_QBO_CLIENT_SECRET=
ELIO_QBO_REDIRECT_URI=http://localhost:8080/

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=

# LLM Routing
ELIO_LLM_MODE=hybrid
ELIO_ALLOW_LOCAL_FALLBACK=true
ELIO_LOCAL_BASE_URL=http://ollama:11434/v1
ELIO_LOCAL_API_KEY=ollama
ELIO_CLOUD_CHAT_MODEL=gpt-4o
ELIO_CLOUD_FAST_MODEL=gpt-4o-mini
ELIO_CLOUD_VISION_MODEL=gpt-4o
ELIO_CLOUD_EMBED_MODEL=text-embedding-3-small
ELIO_LOCAL_CHAT_MODEL=qwen3:8b
ELIO_LOCAL_FAST_MODEL=qwen3:8b
ELIO_LOCAL_VISION_MODEL=qwen2.5vl:7b
ELIO_LOCAL_EMBED_MODEL=nomic-embed-text
ELIO_ROUTE_BRAIN=cloud
ELIO_ROUTE_INTAKE=local
ELIO_ROUTE_MISSION=local
ELIO_ROUTE_MEETING=local
ELIO_ROUTE_EMBEDDINGS=local
ELIO_ROUTE_RECEIPT_VISION=cloud
ELIO_ROUTE_SELF_AUDIT=cloud
ELIO_ROUTE_SKILL_CODEGEN=cloud

# Private Subagent
ELIO_SUBAGENT_ENABLED=true
ELIO_SUBAGENT_URL=http://subagent:8010
ELIO_SUBAGENT_TOKEN=replace-with-a-long-random-shared-secret
ELIO_SUBAGENT_PORT=8010

# Voice + Personality
ELIO_PERSONALITY_PROFILE=executive-operator
ELIO_TTS_PROVIDER=kokoro
ELIO_TTS_VOICE=af_heart
ELIO_TTS_SPEED=1.0
ELIO_TTS_LANG=en-us
ELIO_KOKORO_MODEL_PATH=kokoro-v1.0.onnx
ELIO_KOKORO_VOICES_PATH=voices-v1.0.bin
ELIO_REMOTE_TTS_URL=
ELIO_XTTS_BIND_IP=127.0.0.1
ELIO_XTTS_PORT=8020
ELIO_XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
ELIO_XTTS_USE_GPU=false
ELIO_XTTS_SPLIT_SENTENCES=true

# Local seed defaults (optional)
ELIO_ADMIN_USER=
ELIO_ADMIN_PASS=
ELIO_EMAIL_ID=
ELIO_EMAIL_PASS=
