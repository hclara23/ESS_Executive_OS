# Example environment file for local development.
# Copy to .env and fill in secrets. This file intentionally keeps
# values minimal and documents a persistent opt-out for Next.js telemetry.

# Persistent opt-out for Next.js anonymous telemetry (set to 1 to disable)
NEXT_TELEMETRY_DISABLED=1

# Example Elio vars (fill appropriately)
# ELIO_JWT_SECRET=changeme
# ELIO_SUPERUSER_EMAIL=you@example.com
# ELIO_REDIS_URL=redis://127.0.0.1:6379/0
