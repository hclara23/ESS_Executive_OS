# ==========================================
# ESS Autonomous Growth System - Environment
# ==========================================

# Database
DB_PASSWORD=ess_secure_password_change_me
EDGE_NETWORK=platform_edge

# WordPress Integration
WP_URL=https://your-wordpress-site.com
WP_USERNAME=your_wp_username
WP_PASSWORD=your_wp_application_password
WP_JWT_SECRET=your_jwt_secret_key_set_in_wp_config

# LLM Providers (fill at least one)
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
LLM_PROVIDER=openai

# Google Analytics 4
GA4_PROPERTY_ID=your_ga4_property_id
GA4_CREDENTIALS=path/to/ga4_service_account.json

# Local private loopback ports
ESS_API_PORT=18080
ESS_N8N_PORT=15678
ESS_NGINX_PORT=18081
N8N_EXECUTIONS_MODE=regular

# Optional: Vector DB (Phase 2+)
VECTOR_DB_URL=http://localhost:6333
